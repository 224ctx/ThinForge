# === ThinForge Environment Template ===
#
# Copy this file to `.env` and fill in the blanks for your setup.
# `.env` is git-ignored and must stay local.
#
#     cp .env.example .env
#
# CHANGE_ME placeholders are replaced with secure random values
# automatically when .env is generated by install-deps.sh or rebuild.sh.
#

# PostgreSQL
POSTGRES_USER=thinforge
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=thinforge

# Database pools (optional; empty = defaults, see
# crates/thinforge-core/src/config.rs). API: default 50 / 10. Worker: default
# 24 / 2, sized for 12 parallel jobs plus the cron loops. Keep the sum of all
# pools below Postgres max_connections (image default 100, 3 of them reserved
# for superusers): API 50 + worker 24 + migrator 5 (only while a container
# starts) = 79. Both compose files pass these to the backend and the worker.
#DB_MAX_CONNECTIONS=50
#DB_MIN_CONNECTIONS=10
#WORKER_DB_MAX_CONNECTIONS=24
#WORKER_DB_MIN_CONNECTIONS=2

# Grafana admin
GRAFANA_PASSWORD=CHANGE_ME_grafana_admin_password

# Semaphore admin (Ansible CI/CD UI)
# IMPORTANT: changing this requires recreating the semaphore container so it
# picks up the new env var. See docs/security/security-audit-2026-04-18.md F-HI-09.
SEMAPHORE_ADMIN_PASSWORD=CHANGE_ME_semaphore_admin_password

# Redis (job queue, token blacklist) — REQUIRED. The stack refuses to start
# without it (compose `${REDIS_PASSWORD:?}`); redis-server runs with
# `--requirepass`, backend and worker connect via `redis://:<pw>@redis:6379/0`.
# Existing installations: rebuild.sh / deploy.sh / clean-reset.sh append a
# generated value automatically (scripts/lib-env.sh::ensure_env_secrets).
# Changing it requires recreating redis, backend AND worker in one go:
#   docker compose up -d --force-recreate redis backend worker
# Use URL-safe characters only (letters, digits, `-`, `_`, `.`): the value is
# embedded in a URL and interpolated by compose (`$` would be expanded).
REDIS_PASSWORD=CHANGE_ME_redis_password

# SECRET_KEY is auto-generated at first start (stored in STORAGE_DIR/.secret_key).
# No need to set it manually.

# ANSIBLE_INVENTORY_TOKEN is auto-generated at first start as well (stored in
# STORAGE_DIR/.ansible_inventory_token). No need to set it manually; setting it
# here only seeds the file once (one-shot migration, the file stays canonical).

# Storage base directory — host path bind-mounted to /data in the backend.
# All derived paths (clones, isos, captures, exports, …) live under here.
STORAGE_DIR=./ThinForgeDaten

# Cloning VM defaults — override per environment as needed.
CLONING_VM_ISO_PATH=
CLONING_VM_RAM=4096
CLONING_VM_CPUS=2
CLONING_VM_MEM_LIMIT=5g
CLONING_VM_KVM_ENABLED=true

# Services-Panel filter — comma-separated list of compose profiles that are
# part of this deployment (plus profile-less "core" services always shown).
# rebuild.sh / deploy.sh fill in their default (START_PROFILES plus the
# on-demand profiles) only while this line is missing, empty or holds an
# earlier default; override it here to hide profile-gated services (e.g.
# leave `testing` out on installations without KVM) and the scripts keep
# your value. Delete the line to return to the default.
# Empty = default (network,monitoring,testing,cloner,bittorrent,multicast).
THINFORGE_ENABLED_PROFILES=

# --- Abrufe nach aussen beim Schwachstellen-Scan ---
# Beide sind standardmaessig AUS: ohne eigenen Eintrag spricht der Scan weder
# git.thinforge.org noch cisa.gov an. Bis 2026-10 trug diese Vorlage beide als
# Vorgabe ein; eine bestehende .env mit genau diesen frueheren Werten stellt
# scripts/lib-env.sh beim naechsten ./deploy.sh bzw. ./rebuild.sh einmalig auf
# aus (eine andere URL, etwa ein eigener Spiegel, bleibt stehen).
#
# Vulnerability Acceptance List:
# Mode "local"  = ausschliesslich die im Backend gebundelte Liste verwenden,
#                 kein Abruf (Vorgabe).
# Mode "remote" = nach jedem Vuln-Scan (im Nachlauf) die ersten 4 KB der
#                 Remote-Liste auf eine neuere Version pruefen; das Vuln-Panel
#                 liest nur diesen Zwischenstand. Ausgewertet wird weiter die
#                 gebundelte Liste.
# Einschalten: Mode auf remote setzen und die URL-Zeile einkommentieren
# (oder eine eigene HTTPS-Adresse eintragen).
THINFORGE_ACCEPTANCE_LIST_MODE=local
# Nur bei MODE=remote ausgewertet. HTTPS only.
# THINFORGE_ACCEPTANCE_LIST_URL=https://git.thinforge.org/thinforge/ThinForge-Release/raw/branch/master/docs/security/vulnerability-acceptance.md

# KEV-Anreicherung (CISA Known Exploited Vulnerabilities) fuer den Schwachstellen-
# Bericht: markiert Funde, die nachweislich aktiv ausgenutzt werden. Abruf zur
# Scan-Zeit (graceful: offline -> ohne KEV-Markierung). Leer = aus (Vorgabe);
# fehlt die Zeile oder die Variable ganz, ist KEV ebenfalls aus. Einschalten:
# den CISA-Feed (Zeile darunter einkommentieren) oder einen eigenen HTTPS-
# Spiegel eintragen.
THINFORGE_KEV_URL=
# THINFORGE_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
