# === ThinForge Environment Template ===
#
# Copy this file to `.env` and fill in the blanks for your setup.
# `.env` is git-ignored and must stay local.
#
#     cp .env.example .env
#
# CHANGE_ME placeholders are replaced with secure random values
# automatically when .env is generated by install-deps.sh or rebuild.sh.
#

# PostgreSQL
POSTGRES_USER=thinforge
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=thinforge

# Grafana admin
GRAFANA_PASSWORD=CHANGE_ME_grafana_admin_password

# Semaphore admin (Ansible CI/CD UI)
# IMPORTANT: changing this requires recreating the semaphore container so it
# picks up the new env var. See docs/security-audit-2026-04-18.md F-HI-09.
SEMAPHORE_ADMIN_PASSWORD=CHANGE_ME_semaphore_admin_password

# SECRET_KEY is auto-generated at first start (stored in STORAGE_DIR/.secret_key).
# No need to set it manually.

# Storage base directory — host path bind-mounted to /data in the backend.
# All derived paths (clones, isos, captures, exports, …) live under here.
STORAGE_DIR=./ThinForgeDaten

# Cloning VM defaults — override per environment as needed.
CLONING_VM_ISO_PATH=
CLONING_VM_RAM=4096
CLONING_VM_CPUS=2
CLONING_VM_DISK_SIZE=50G
CLONING_VM_MEM_LIMIT=5g
CLONING_VM_KVM_ENABLED=true

# Network: upstream DNS for the management LAN.
# Leave empty to fall back to the default gateway.
MANAGEMENT_DNS=

# Services-Panel filter — comma-separated list of compose profiles that are
# part of this deployment (plus profile-less "core" services always shown).
# Auto-maintained by rebuild.sh from START_PROFILES; override here to hide
# profile-gated services (e.g. leave `testing` out on installations without
# KVM). Empty = default (network,monitoring,testing,cloner).
THINFORGE_ENABLED_PROFILES=

# --- Vulnerability Acceptance List ---
# Mode "local" = ausschliesslich die im Backend gebundelte Liste verwenden.
# Mode "remote" = vor jedem Vuln-Scan und beim Vuln-Panel-Mount die Remote-
#                 Liste auf Versions-Updates pruefen. Default seit 2026-05-18:
#                 "remote" — Release-Repo liefert die Datei via Push-Flow mit.
THINFORGE_ACCEPTANCE_LIST_MODE=remote
# Nur bei MODE=remote ausgewertet. HTTPS only.
THINFORGE_ACCEPTANCE_LIST_URL=https://git.example.com/thinforge/ThinForge-Release/raw/branch/master/docs/security/vulnerability-acceptance.md

# KEV-Anreicherung (CISA Known Exploited Vulnerabilities) fuer den Schwachstellen-
# Bericht. Online-Fetch zur Scan-Zeit (graceful: offline -> ohne KEV-Markierung).
# Leer = deaktiviert (airgapped). Default = CISA-Feed; auf einen eigenen Mirror
# umstellbar.
THINFORGE_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
